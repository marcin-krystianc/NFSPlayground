index b426b3e64df8..50e5aee8b49b 100644
--- a/fs/nfsd/nfs3acl.c
+++ b/fs/nfsd/nfs3acl.c
@@ -480,11 +480,11 @@ bool nfs_acl3_secattr_decode_begin(struct xdrgen_aggregate_cursor *c)
 			argp->invalid = true;
 			return true;
 		}
-		if (!dfacl && !c->count) {
-			argp->invalid = true;
-			return true;
-		}
