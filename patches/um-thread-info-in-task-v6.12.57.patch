index b11ed66c8b..be109103ae 100644
--- a/arch/um/os-Linux/signal.c
+++ b/arch/um/os-Linux/signal.c
@@ -190,43 +190,8 @@ static void hard_handler(int sig, siginfo_t *si, void *p)
