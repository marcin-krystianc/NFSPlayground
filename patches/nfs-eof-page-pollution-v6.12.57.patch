# Backport to v6.12.57 of three upstream NFS client commits that together
# stop 'eof page pollution':
#
#   b1817b18ff20 ("NFS: Protect against 'eof page pollution'",
#                 Trond Myklebust, 2025-09-04)
#   b2036bb65114 ("NFSv4.2: Protect copy offload and clone against 'eof
#                 page pollution'", Trond Myklebust, 2025-09-06)
#   d5811e6297f3 ("NFS: Fix size read races in truncate, fallocate and copy
#                 offload", Trond Myklebust, 2026-01-10; Fixes: b1817b18ff20)
#
# b1817b18ff20's message: "This commit fixes the failing xfstest
# 'generic/363'. When the user mmaps() an area that extends beyond the end
# of file, and proceeds to write data into the folio that straddles that
# eof, we're required to discard that folio data if the user calls some
# function that extends the file length." It adds nfs_truncate_last_folio()
# and calls it from nfs_write_begin(), nfs_setattr() and ALLOCATE; the other
# two extend it to copy offload and clone and read the old size under the
# lock. The generic/363 port failed on the kunit-v6-12-57-patched CI leg
# with fsx's "READ BAD DATA" (exit 110) after an extending write. None of
# the three carries `Cc: stable@vger.kernel.org`, and linux-6.12.y does not
# have nfs_truncate_last_folio() up to v6.12.111.
#
# This is NOT a straight cherry-pick. v6.12.57 has no ZERO_RANGE support
# (no nfs42_proc_zero_range(), no NFS_CAP_ZERO_RANGE), so:
#   - b1817b18ff20's and d5811e6297f3's hunks for nfs42_proc_zero_range()
#     are dropped;
#   - in nfs42_proc_allocate() the -EOPNOTSUPP branch clears only
#     NFS_CAP_ALLOCATE, as v6.12.57 already did, instead of
#     NFS_CAP_ALLOCATE | NFS_CAP_ZERO_RANGE;
#   - nfs_setattr()'s declaration of oldsize is changed in place, since
#     the upstream context lines (task_uid, owner_uid) are not in v6.12.57.
# b2036bb65114 and the io.c exports of d5811e6297f3 apply unchanged.
#
# Verified in this repo (2026-09-28): `git apply --check` applies cleanly to
# a fresh v6.12.57 checkout, and `make ARCH=um fs/nfs/` builds it with
# NFS_V4_2 and NFSD enabled, without warnings. It touches only fs/nfs/, so
# it is independent of um-thread-info-in-task-v6.12.57.patch.
diff --git a/fs/nfs/file.c b/fs/nfs/file.c
index a16a619fb8..8cc39a73fa 100644
--- a/fs/nfs/file.c
+++ b/fs/nfs/file.c
@@ -28,6 +28,7 @@
 #include <linux/mm.h>
 #include <linux/pagemap.h>
 #include <linux/gfp.h>
+#include <linux/rmap.h>
 #include <linux/swap.h>
 #include <linux/compaction.h>
 
@@ -279,6 +280,37 @@ nfs_file_fsync(struct file *file, loff_t start, loff_t end, int datasync)
 }
 EXPORT_SYMBOL_GPL(nfs_file_fsync);
 
+void nfs_truncate_last_folio(struct address_space *mapping, loff_t from,
+			     loff_t to)
+{
+	struct folio *folio;
+
+	if (from >= to)
+		return;
+
+	folio = filemap_lock_folio(mapping, from >> PAGE_SHIFT);
+	if (IS_ERR(folio))
+		return;
+
+	if (folio_mkclean(folio))
+		folio_mark_dirty(folio);
+
+	if (folio_test_uptodate(folio)) {
+		loff_t fpos = folio_pos(folio);
+		size_t offset = from - fpos;
+		size_t end = folio_size(folio);
+
+		if (to - fpos < end)
+			end = to - fpos;
+		folio_zero_segment(folio, offset, end);
+		trace_nfs_size_truncate_folio(mapping->host, to);
+	}
+
+	folio_unlock(folio);
+	folio_put(folio);
+}
+EXPORT_SYMBOL_GPL(nfs_truncate_last_folio);
+
 /*
  * Decide whether a read/modify/write cycle may be more efficient
  * then a modify/write/read cycle when writing to a page in the
@@ -353,6 +385,7 @@ static int nfs_write_begin(struct file *file, struct address_space *mapping,
 
 	dfprintk(PAGECACHE, "NFS: write_begin(%pD2(%lu), %u@%lld)\n",
 		file, mapping->host->i_ino, len, (long long) pos);
+	nfs_truncate_last_folio(mapping, i_size_read(mapping->host), pos);
 
 	fgp |= fgf_set_order(len);
